common:
  lidar_topic: "/LIDAR/POINTS"
  livox_lidar_topic: "/livox/lidar" # 不使用，也要有，否则会报错
  imu_topic: "/IMU"

# fasterlio 参数（LIO已完全跳过，此部分仅用于预处理降采样）
fasterlio:
  lidar_type: 4
  scan_line: 32
  blind: 0.5
  time_scale: 1e-3

  skip_lidar_num: 0
  point_filter_num: 6
  max_iteration: 2
  filter_size_scan: 0.5
  filter_size_map: 0.5

  ivox_grid_resolution: 0.5        # default=0.2
  ivox_nearby_type: 18             # 6, 18, 26
  esti_plane_threshold: 0.1        # default=0.1

  use_aa: false  # use anderson-acceleration

  acc_cov: 0.1
  gyr_cov: 0.1
  b_acc_cov: 0.0001
  b_gyr_cov: 0.0001
  extrinsic_est_en: false      # true: enable the online estimation of IMU-LiDAR extrinsic
  extrinsic_T: [ -0.0632, 0.1068, 0.0305 ]  # LiDAR在IMU系下位置(mm: -63.2,106.8,30.5)
  extrinsic_R: [ 1, 0, 0,
                 0, 1, 0,
                 0, 0, 1 ]
  keep_first_imu_estimation: false


g2p5:
  esti_floor: false   # 是否动态估计地面
  lidar_height: 0.0   # 雷达安装高度
  floor_height: -1.2   # 默认地面高度
  min_th_floor: 0.50  # 距离地面这个高度的障碍物被扫入栅格地图中
  max_th_floor: 1.0  # 距离地面这个高度的障碍物被扫入栅格地图中
  grid_map_resolution: 0.2 # 栅格地图分辨率

system:
  with_loop_closing: false # 是否需要回环检测
  with_ui: false # 是否需要3D UI
  with_2dui: false # 是否需要2D UI
  with_g2p5: false # 是否需要栅格地图
  step_on_kf: false # 是否在关键帧处暂停
  log_pose_opt: false # 命令行打印位置和速度
  pub_odom: true
  enable_lidar_loc_skip: true
  enable_lidar_loc_rviz: false
  enable_path_rviz: false
  enable_lidar_odom_skip: false
  evaluation: false
  lidar_loc_skip_num: 15
  lidar_odom_skip_num: 1
  map_path: ./data/office4f/
  use_init_pose: false
  # 初始位置 [x, y, z]
  init_pos: [0.0, 0.0, 0.0]
  # 初始四元数 [x, y, z, w]
  init_quat: [0.0, 0.0, 0.0, 1.0]
  pub_tf: true

loop_closing:
  loop_kf_gap: 10       # 每隔多少个关键帧检查一次
  min_id_interval: 20   # 被检查的关键帧ID间隔
  closest_id_th: 20     # 历史关键帧与当前帧的ID间隔
  max_range: 60.0       # 候选帧的最大距离
  ndt_score_th: 2.0     # ndt位姿分值
  with_height: true


### localization ================================================================================================
lidar_loc:
  enable_dynamic_polygon: false
  enable_parking_static: true
  enable_icp_adjust: false
  filter_intensity_max: 100.0
  filter_intensity_min: 10.0
  filter_z_max: 30.0
  filter_z_min: -1.0
  force_2d: false
  grid_search_angle_range: 180.0
  grid_search_angle_step: 120
  lidar_loc_odom_th: 1.0
  init_with_fp: true
  min_init_confidence: 2.0
  update_dynamic_cloud: false
  update_err_h: 0.2
  update_err_v: 0.2
  update_kf_dis: 2.0
  update_lidar_loc_score: 2.5
  loc_on_kf: false
  try_self_extrap: false
maps:
  delete_when_unload: false
  dyn_cloud_policy: short
  load_dyn_cloud: false
  load_map_size: 2
  max_pts_dyn_chunk: 100000
  save_dyn_when_quit: false
  save_dyn_when_unload: false
  unload_map_size: 4
  with_dyn_area: false
# fuse LIO, LiDAR localization( requires a pre-built map), Dead Reckoning, RTK
pgo:  
  # DR noise - DR is from leg odometry, which is accurate short-term
  dr_pos_noise: 1.0
  dr_ang_noise: 0.5
  # LIO noise - LIO is used less now, trust it less
  lidar_odom_pos_noise: 2.0
  lidar_odom_ang_noise: 2.0
  # LidarLoc noise - trust lidar_loc more (it's our main global correction)
  lidar_loc_pos_noise: 0.2
  lidar_loc_ang_noise: 0.2
  # Stricter outlier rejection - don't accept bad matches
  lidar_loc_outlier_th: 5.0
  # Normal convergence criteria
  pgo_frame_converge_pos_th: 0.05
  pgo_frame_converge_ang_th: 1.0
  rtk_fix_ang_noise: 2.0
  rtk_fix_pos_noise: 1.0
  rtk_height_noise_ratio: 10.0
  rtk_other_ang_noise: 10.0
  rtk_other_pos_noise: 5.0
  rtk_outlier_th: 1.0
  smooth_factor: 0.01
roi:
  height_max: 0.5
  height_min: -2.0
  range_max: 70
  range_min: 3.0
ui:
  car_length: 2.0
  car_width: 1.6
  car_height: 1.7
  scans: 1
